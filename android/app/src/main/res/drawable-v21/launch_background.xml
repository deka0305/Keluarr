<?xml version="1.0" encoding="utf-8"?>
<!-- Splash native: yang terlihat SEBELUM engine Flutter menggambar frame
     pertama. Logonya transparan, jadi satu berkas ini benar di tema terang
     maupun gelap — tanpa itu, layar kosong sempat berkedip lalu berganti
     logo, dan pembukaan app terasa dua tahap. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
