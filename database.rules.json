{
  "rules": {
    "keluarr": {
      "$code": {
        // Hanya anggota yang boleh membaca grup. Kode undangan = kunci node,
        // jadi orang luar tidak bisa menebak jalan masuk; tapi membaca tetap
        // butuh baris di members/{uid}.
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",

        // HAPUS GRUP oleh admin. Sengaja dibatasi `!newData.exists()`, yaitu
        // hanya penghapusan seluruh node. Kalau ditulis sebagai izin tulis
        // umum, izin itu menurun ke SEMUA anaknya — dan admin jadi bisa
        // menimpa `live/{uid}` orang lain, artinya memalsukan posisi anggota.
        ".write": "auth != null && data.child('meta/adminUid').val() === auth.uid && !newData.exists()",

        "meta": {
          // Grup baru: penulis wajib menuliskan dirinya sebagai adminUid.
          // Grup yang sudah ada: hanya admin yang boleh mengubah.
          ".write": "auth != null && ((!data.exists() && newData.child('adminUid').val() === auth.uid) || data.child('adminUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['name', 'adminUid'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "sport": { ".validate": "newData.val() === 'run' || newData.val() === 'hike' || newData.val() === 'bike' || newData.val() === 'walk'" },
          "targetKm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          // Admin boleh menyerahkan jabatan (desain 16: admin keluar → pilih
          // pengganti), tapi hanya ke orang yang benar-benar anggota. Tanpa
          // syarat ini satu salah tulis membuat grup yatim: adminUid menunjuk
          // uid yang tidak ada, dan tidak seorang pun bisa mengubah atau
          // menghapusnya lagi.
          //
          // `newData.val() === auth.uid` WAJIB ada sebagai cabang pertama.
          // Saat grup dibuat, `meta` ditulis sebelum `members/{uid}`, jadi
          // syarat keanggotaan saja membuat pembuatan grup mustahil — ayam dan
          // telur. Menunjuk diri sendiri selalu sah; menunjuk orang lain harus
          // anggota.
          "adminUid": {
            ".validate": "newData.isString() && (newData.val() === auth.uid || root.child('keluarr').child($code).child('members').child(newData.val()).exists())"
          },
          "createdMs": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "members": {
          "$uid": {
            // Bergabung: siapa pun yang login boleh menulis barisnya SENDIRI
            // (itulah cara masuk sebelum bisa membaca). Admin boleh menghapus
            // baris orang lain — dasar fitur "keluarkan anggota".
            ".write": "auth != null && !root.child('keluarr').child($code).child('banned').child(auth.uid).exists() && ($uid === auth.uid || (root.child('keluarr').child($code).child('meta').child('adminUid').val() === auth.uid && !newData.exists()))",
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "role": { ".validate": "newData.val() === 'admin' || newData.val() === 'member'" },
            "joinedMs": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "live": {
          "$uid": {
            // Posisi hanya bisa ditulis oleh yang bersangkutan — tidak ada cara
            // memalsukan lokasi orang lain. Admin boleh menghapus (mengeluarkan).
            ".write": "auth != null && ($uid === auth.uid || (root.child('keluarr').child($code).child('meta').child('adminUid').val() === auth.uid && !newData.exists()))",
            ".validate": "newData.hasChildren(['lat', 'lng'])",
            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300" },
            "h": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360" },
            "sport": { ".validate": "newData.isString()" },
            "st": { ".validate": "newData.val() === 'moving' || newData.val() === 'paused'" },
            "t": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "stats": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || (root.child('keluarr').child($code).child('meta').child('adminUid').val() === auth.uid && !newData.exists()))",
            "km": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "n": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "sec": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        },

        "banned": {
          "$uid": {
            ".write": "auth != null && root.child('keluarr').child($code).child('meta').child('adminUid').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },

        // Tidak ada node untuk jejak GPS. Ini bagian dari janji privasi app:
        // apa pun yang mencoba menulis `track` di sini ditolak server.
        "$other": { ".validate": false }
      }
    }
  }
}
